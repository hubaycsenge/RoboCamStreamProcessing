# Mecanumbot over the permanent robot-initiated reverse tunnel (nipg1:8200 -> robot:22).
# Included from ~/.ssh/config. Managed in ~/mecanumbot-link/ (separate from deep3r).
Host mecanumbot robot
    HostName 127.0.0.1
    Port 8200
    User ubuntu
    StrictHostKeyChecking accept-new
    ServerAliveInterval 20
    ServerAliveCountMax 3

# The laptop's ad-hoc tunnel lands here instead. Open it with
#   ssh -R 8222:"$(./robot-addr.sh)":22 csengehubay@nipg1.inf.elte.hu
# rather than a literal address: the lab has two routers, and the robot is
# 192.168.0.240 behind 192.168.0.1 and 192.168.1.240 behind 192.168.1.1.
Host mecanumbot-laptop
    HostName 127.0.0.1
    Port 8222
    User ubuntu
    StrictHostKeyChecking accept-new

# The same robot, reached from a machine that is NOT nipg1 -- a laptop off the
# lab WiFi, or anywhere with an nipg1 login. ProxyJump makes 127.0.0.1:8200
# resolve *on nipg1*, which is where the robot's reverse forward binds
# (GatewayPorts defaults to no, so it binds nipg1's loopback and nowhere else).
#
#   MECANUMBOT_SSH_HOST=mecanumbot-jump robot web
#   MECANUMBOT_SSH_HOST=mecanumbot-jump robot topic list
Host mecanumbot-jump
    HostName 127.0.0.1
    Port 8200
    User ubuntu
    ProxyJump csengehubay@nipg1.inf.elte.hu
    StrictHostKeyChecking accept-new
    ServerAliveInterval 20
    ServerAliveCountMax 3
